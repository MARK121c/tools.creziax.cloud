# ==============================================================
# Automated AI Sales Agency & CRM System - Environment Variables
# Cost-Free Architecture for Hostinger VPS & Local Deployment
# ==============================================================

# Database (SQLite local file)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Free Tier from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# YouTube Data API v3 Key (Free 10,000 units/day from Google Cloud Console)
YOUTUBE_API_KEY=""

# Hostinger SMTP Mailing Credentials
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="outreach@yourdomain.com"
SMTP_PASS="your-email-password"
SMTP_SENDER_NAME="فريق النمو والشراكات | Apex Media"

# Discovery Booking Link (Calendly or Cal.com)
BOOKING_LINK="https://calendly.com/your-agency/15min"

# Telegram Bot Instant Meeting Alerts (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Application Port
PORT=3000
NODE_ENV="production"
