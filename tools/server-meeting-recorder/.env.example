# ==============================================================================
# Creziax Server Meeting Recorder - Environment Configuration
# ==============================================================================

# Server settings
APP_NAME="Creziax Server Meeting Recorder"
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080

# Security (Leave blank to disable API Key requirement, or set a secure token)
API_KEY=your_secure_api_key_here

# Virtual Display & Audio
XVFB_DISPLAY=:99
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
SCREEN_DEPTH=24
PULSE_SINK_NAME=CreziaxVirtualSink

# Recording & Compression Defaults
DEFAULT_FPS=30
VIDEO_CODEC=libx264
VIDEO_PRESET=veryfast
VIDEO_CRF=23
AUDIO_CODEC=aac
AUDIO_BITRATE=192k

# Bot Profile Defaults
DEFAULT_BOT_NAME="Creziax Recorder Bot"
DEFAULT_MAX_DURATION_MINUTES=180

# Retention and Storage Cleanup
RETENTION_DAYS=30
MAX_DISK_USAGE_PERCENT=90
